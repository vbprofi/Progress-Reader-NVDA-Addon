#: addon\globalPlugins\progressReader.py:411
msgid ""
"Öffnet ein Fenster mit automatischer Aktualisierung der Progressbar (merkt "
"beim Öffnen gefundene Progress-Objekte)"
msgstr ""
"Mở một cửa sổ với một thanh tiến trình được cập nhật tự động (ghi nhớ các "
"thanh tiến trình được tìm thấy khi mở)"

#: addon\globalPlugins\progressReader.py:424
